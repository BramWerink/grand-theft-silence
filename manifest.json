{
  "manifest_version": 3,
  "name": "Grand Theft Silence",
  "version": "1.1.0",
  "description": "Hides posts, videos and articles that mention GTA 6 / GTA VI / Grand Theft Auto 6.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Grand Theft Silence",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
